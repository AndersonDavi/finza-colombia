<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/widget_container"
    android:layout_margin="6dp">
	<ImageView
        android:id="@+id/widget_background"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background"
    />
	<LinearLayout
        android:id="@+id/pockets_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="12dp">
		<TextView
            android:id="@+id/pockets_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
        />
		<TextView
            android:id="@+id/pockets_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
        />
		<TextView
            android:id="@+id/pockets_lines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Tap to open"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:textColor="#000000"
        />
	</LinearLayout>
	<!-- The card drawn by the app; the texts above stay as the fallback -->
	<ImageView
        android:id="@+id/pockets_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:visibility="gone"
    />
</FrameLayout>
